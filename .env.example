# Sports Sponsorship Valuator - Environment Configuration

# NewsAPI key for brand mention tracking
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Twitter/X API v2 Bearer Token for social metrics
# Get access at https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Optional: Override default discount rate for NPV calculations (decimal, e.g. 0.10 for 10%)
DEFAULT_DISCOUNT_RATE=0.10

# Optional: Override default sponsorship growth rate assumption
DEFAULT_GROWTH_RATE=0.05

# Optional: Currency for output (USD or EUR)
DEFAULT_CURRENCY=USD
